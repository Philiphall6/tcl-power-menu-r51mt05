<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.philphall.tclpowermenu"
    android:versionCode="7"
    android:versionName="0.7">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:label="@string/app_name"
        android:theme="@style/PowerMenuTheme">

        <uses-library android:name="com.tcl.tvmanager" android:required="false" />
        <uses-library android:name="com.tcl.os.system" android:required="false" />

        <activity
            android:name=".PowerMenuActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/PowerMenuTheme" />

        <service
            android:name=".PowerAccessibilityService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
